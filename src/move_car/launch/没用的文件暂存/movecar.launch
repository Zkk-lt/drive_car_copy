<launch>
    <node pkg="move_car" type="control_pub"  name="publish_speed_turn" output="screen">
        <param name="control_rate" value="20.0" />
        <param name="max_speed" value="0.50" />
        <param name="max_accel" value="0.10" />
        <param name="min_accel" value="-0.22" />
        <param name="max_steer" value="0.38" />
        <param name="max_steer_rate" value="0.06" />
        <param name="desired_follow_distance" value="1.55" />
        <param name="target_timeout" value="0.60" />
        <param name="target_hold_timeout" value="1.00" />
        <param name="emergency_stop_distance" value="0.50" />
        <param name="stop_buffer_distance" value="0.70" />
        <param name="horizon_steps" value="20" />
        <param name="horizon_dt" value="0.10" />
        <param name="reference_history_window" value="1.00" />
        <param name="fit_min_samples" value="4" />
        <param name="fit_max_rms" value="0.35" />
        <param name="fit_blend_gain" value="3.6" />
        <param name="outlier_reject_distance" value="0.30" />
        <param name="outlier_reject_speed" value="0.55" />
        <param name="huber_delta" value="0.08" />
        <param name="fit_ridge_lambda" value="0.55" />
        <param name="low_speed_heading_threshold" value="0.30" />
        <param name="low_speed_span_threshold" value="0.55" />
        <param name="heading_memory_alpha" value="0.90" />
        <param name="curvature_memory_alpha" value="0.88" />
        <param name="max_curvature" value="0.14" />
        <param name="max_curvature_rate" value="0.012" />
        <param name="max_heading_step" value="0.035" />
        <param name="gap_speed_gain" value="0.16" />
        <param name="fit_bad_speed_scale" value="0.80" />
        <param name="min_progress_speed" value="0.16" />
        <param name="preview_speed_steps" value="5" />
        <param name="line_search_decay" value="0.50" />
        <param name="temporal_heading_weight" value="2.4" />
        <param name="temporal_speed_weight" value="1.2" />
        <param name="lock_distance_gate" value="0.85" />
        <param name="lock_yaw_gate" value="0.90" />
        <param name="lock_hold_timeout" value="1.20" />
        <param name="al_outer_iterations" value="3" />
        <param name="al_violation_tolerance" value="0.02" />
        <param name="mu_penalty" value="8.0" />
        <param name="mu_growth" value="1.25" />
        <param name="q_x" value="2.5" />
        <param name="q_y" value="14.0" />
        <param name="q_yaw" value="4.0" />
        <param name="q_v" value="2.0" />
        <param name="r_a" value="0.35" />
        <param name="r_delta" value="0.55" />
        <param name="r_da" value="1.40" />
        <param name="r_ddelta" value="1.80" />
        <param name="terminal_x_weight" value="4.0" />
        <param name="terminal_y_weight" value="18.0" />
        <param name="terminal_yaw_weight" value="6.0" />
        <param name="speed_penalty" value="160.0" />
        <param name="clearance_penalty" value="220.0" />
    </node>
</launch>
